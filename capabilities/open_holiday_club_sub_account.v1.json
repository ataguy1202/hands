  "schemaVersion": "1.0",
  "id": "cap_open_holiday_club_sub_account",
  "name": "open_holiday_club_sub_account",
  "version": 1,
  "status": "approved",
  "description": "Open a Holiday Club (S20) sub-account for a member in Meridian CoreSuite with an initial deposit, and return the confirmation number and the new share id.",
  "app": {
    "id": "meridian-coresuite",
    "surface": "legacy-web",
    "entry": "http://localhost:4100/login"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "description": "Member number, 5 digits",
      "required": true,
      "pattern": "^\\d{5}$",
      "example": "10077",
      "sensitive": false
    },
    "nickname": {
      "type": "string",
      "description": "Nickname for the new sub-account, up to 20 characters",
      "required": true,
      "pattern": "^.{1,20}$",
      "example": "Vacation",
      "sensitive": false
    },
    "initialDeposit": {
      "type": "string",
      "description": "Initial deposit in dollars, e.g. 25.00 (minimum 5.00)",
      "required": true,
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "example": "25.00",
      "sensitive": false
    }
  },
  "outputs": {
    "confirmationNumber": {
      "type": "string",
      "description": "Confirmation number shown on the Sub-Account Opened screen"
    },
    "shareId": {
      "type": "string",
      "description": "Share id assigned to the new sub-account, e.g. S21"
    }
  },
