# Model access for discovery runs only. Replay never uses it. Set one of the two.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Credentials the runtime fills into the target sign-on form.
# Referenced by name from artifacts ({"kind":"secret","name":"MERIDIAN_PASSWORD"}) and never written to disk.
MERIDIAN_USER=operator
MERIDIAN_PASSWORD=meridian1
